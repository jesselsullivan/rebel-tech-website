# Rebel Tech website environment
PORT=3000

# RepairShopr
REPAIRSHOPR_SUBDOMAIN=rebeltech
REPAIRSHOPR_API_KEY=PASTE_YOUR_REPAIRSHOPR_API_KEY_HERE
REPAIRSHOPR_TICKET_FORM_ID=PASTE_YOUR_NEW_TICKET_FORM_ID_HERE

# Brevo SMTP relay
# Keep the SMTP key secret. Do NOT commit it to GitHub.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=b58e03001@smtp-brevo.com
SMTP_PASS=PASTE_YOUR_BREVO_SMTP_KEY_HERE
MAIL_FROM=info@rebeltechoxford.com
MAIL_TO=info@rebeltechoxford.com

# Scheduling (leave blank until the RepairShopr availability widget is ready to embed)
REPAIRSHOPR_SCHEDULING_WIDGET_URL=

# Cloudflare Turnstile — public customer check-in protection
# Create a widget for rebeltechoxford.com (and www.rebeltechoxford.com if you keep it as an allowed hostname).
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_ACTION=customer_checkin
TURNSTILE_HOSTNAMES=rebeltechoxford.com,www.rebeltechoxford.com

# Service area / travel pricing
SERVICE_BASE_ADDRESS=118 Glen Alden Cir, Oxford, MS 38655
SERVICE_RADIUS_MILES=50
INCLUDED_DRIVE_MINUTES=15
TRAVEL_RATE_PER_MILE=2

# Routing/geocoding providers. These defaults are suitable for prototyping;
# use a production provider/proxy with an appropriate usage policy before launch.
GEOCODING_URL=https://nominatim.openstreetmap.org/search
ROUTING_URL=https://router.project-osrm.org/route/v1/driving
GEOCODING_USER_AGENT=Rebel-Tech-Oxford-Website/1.0 (info@rebeltechoxford.com)
